# Copy to `.env` and fill in as needed. `.env` is git-ignored.
# Load it into your shell before running, e.g.:  set -a; source .env; set +a

# --- Feed / strategy overrides (optional) ---
# TB_SYMBOL=ethusdt
# TB_STREAM=bookTicker
# TB_ENTRY_THRESHOLD=0.002
# TB_TAKE_PROFIT=0.0025
# TB_STOP_LOSS=0.0015

# --- Broker ---
# TB_MODE=paper
# TB_STARTING_CASH=10000

# --- Live trading only (keep these secret; never commit) ---
# TB_API_KEY=your_binance_api_key
# TB_API_SECRET=your_binance_api_secret
